# Copy this file to .env and fill in your own values. Never commit .env,
# and never paste keys into chats, tickets or screenshots.

# development | production. In production, LLM providers that may train on
# free-tier data (Gemini free tier) are refused unless marked as paid.
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Frontend origins allowed to call the API (JSON list). Never "*".
# In production every origin must use https://.
CORS_ORIGINS=["http://localhost:5173"]

# Largest accepted request body, in bytes.
MAX_REQUEST_BYTES=65536

# ---- Database (Supabase) ----------------------------------------------------
# From docs/setup/SUPABASE_SETUP.md step 6. DATABASE_URL is SECRET.

# Value 3: the connection string, with your database password filled in.
# Without it, development keeps screening records in memory only.
DATABASE_URL=
# Encrypt the connection. Keep "require" for Supabase.
DATABASE_SSL=require
# Value 1: the Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# ---- LLM (context-aware detector) ------------------------------------------

# Which LLM provider to use: groq (default), gemini, or ollama.
LLM_PROVIDER=groq

# Time limit for the context-aware check. If exceeded, the check is marked
# UNAVAILABLE and the student is warned (fail closed).
CONTEXT_DETECTOR_TIMEOUT_SECONDS=3

# Groq (default): free tier, does not train on API data. Turn on
# Zero Data Retention in console.groq.com -> Settings -> Data Controls.
# Providers retire models: if the server log shows "404 model_not_found",
# pick a current model from console.groq.com and set it here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini: free tier MAY use prompts to improve Google's models.
# Made-up/demo data only, unless billing is enabled on the project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_PAID_TIER=false

# Ollama: free and fully local, needs Ollama installed on the same machine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Rate limits -------------------------------------------------------------

# Screening rate limits, per client and in total, per window (seconds).
SCREENING_RATE_LIMIT_PER_CLIENT=10
SCREENING_RATE_LIMIT_GLOBAL=25
RATE_LIMIT_WINDOW_SECONDS=60
