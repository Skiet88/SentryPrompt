# Which LLM provider the backend uses: groq (default), gemini, or ollama.
LLM_PROVIDER=groq

# development | production. In production, providers that may train on
# free-tier data (Gemini free tier) are refused unless explicitly marked paid.
APP_ENV=development

# Groq (default): free tier, does not train on API data. Turn on
# Zero Data Retention in console.groq.com -> Settings -> Data Controls.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini: free tier MAY use prompts to improve Google's models.
# Use with made-up/demo data only, unless billing is enabled on the project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_PAID_TIER=false

# Ollama: free and fully local, needs Ollama installed on the same machine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
