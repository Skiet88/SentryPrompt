# Copy to .env.local and fill in. These values end up in the browser, so
# only public values belong here: NEVER the Supabase secret key.

# Backend address (no trailing slash).
VITE_API_URL=http://localhost:8000
# Supabase -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
